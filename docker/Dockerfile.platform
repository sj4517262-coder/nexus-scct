FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=4
WORKDIR /app
COPY requirements.txt requirements-platform.txt ./
RUN pip install --no-cache-dir -r requirements-platform.txt
COPY nexus ./nexus
COPY policies ./policies
COPY scripts ./scripts
COPY main.py ./
RUN mkdir -p /app/runtime /app/data && useradd --create-home nexus && chown -R nexus:nexus /app
USER nexus
CMD ["uvicorn","main:app","--host","0.0.0.0","--port","8000"]
