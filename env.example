# ═══════════════════════════════════════════════════════════
# NEXUS Supply Chain Control Tower — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ═══════════════════════════════════════════════════════════

# ─────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
DEBUG=true                       # Set false in production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
HOST=0.0.0.0
PORT=8000
WORKERS=4                        # Uvicorn workers (prod: 2x CPU cores)

# ─────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-jwt-key-minimum-32-characters-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=your-32-byte-encryption-key-base64-encoded

# ─────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ─────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus_db
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql+asyncpg://nexus:change-this-password@localhost:5432/nexus_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30

# ─────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-this-redis-password
REDIS_URL=redis://:change-this-redis-password@localhost:6379/0
REDIS_CACHE_TTL=3600             # 1 hour default cache TTL

# Celery
CELERY_BROKER_URL=redis://:change-this-redis-password@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:change-this-redis-password@localhost:6379/2

# ─────────────────────────────────────────────
# KAFKA
# ─────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT    # SASL_SSL in production
KAFKA_CONSUMER_GROUP_ID=nexus-consumers
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_HEARTBEAT_INTERVAL_MS=10000

# Kafka Topics
KAFKA_TOPIC_DISRUPTIONS=supply-chain.disruptions
KAFKA_TOPIC_INVENTORY=supply-chain.inventory
KAFKA_TOPIC_SHIPMENTS=supply-chain.shipments
KAFKA_TOPIC_DECISIONS=supply-chain.decisions
KAFKA_TOPIC_KPIS=supply-chain.kpis
KAFKA_TOPIC_ALERTS=supply-chain.alerts

# ─────────────────────────────────────────────
# AI / LLM APIs
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
OPENAI_API_KEY=sk-your-openai-api-key-here
LLM_PRIMARY_MODEL=claude-sonnet-4-20250514
LLM_FALLBACK_MODEL=gpt-4-turbo-preview
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# Agent Configuration
AGENT_AUTO_APPROVE_THRESHOLD=0.85       # Confidence threshold for auto-approval
AGENT_MAX_VALUE_AUTO_APPROVE=1000000    # $1M max auto-approve without human
AGENT_ORCHESTRATION_TIMEOUT=180         # 3 minutes max orchestration time
AGENT_MAX_RETRIES=3

# ─────────────────────────────────────────────
# ML OPS
# ─────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=nexus-supply-chain
MLFLOW_MODEL_REGISTRY_URI=http://localhost:5000

# Model Names (MLflow Registry)
MODEL_DEMAND_FORECAST=nexus-tft-forecast
MODEL_SUPPLIER_RISK=nexus-supplier-risk
MODEL_INVENTORY_RL=nexus-inventory-rl
MODEL_ROUTE_OPTIM=nexus-route-optimizer

# DVC Remote Storage
DVC_REMOTE=s3://your-bucket/nexus-dvc
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-east-1

# ─────────────────────────────────────────────
# CORS & RATE LIMITING
# ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://nexus-tower.com
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# ─────────────────────────────────────────────
# MONITORING
# ─────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-this-grafana-password

# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=${ENVIRONMENT}
SENTRY_TRACES_SAMPLE_RATE=0.1

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=nexus-api

# ─────────────────────────────────────────────
# EXTERNAL INTEGRATIONS
# ─────────────────────────────────────────────
# Mapbox (Supply Chain Map)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token-here

# Slack (Notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
SLACK_CHANNEL=#supply-chain-alerts

# Email (Escalation Notifications)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
EMAIL_FROM=nexus@yourcompany.com

# PagerDuty (Critical Alerts)
PAGERDUTY_ROUTING_KEY=your-pagerduty-routing-key

# ─────────────────────────────────────────────
# FRONTEND
# ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=NEXUS Control Tower
NEXT_PUBLIC_APP_VERSION=2.4.0
NEXT_PUBLIC_ENVIRONMENT=${ENVIRONMENT}

# ─────────────────────────────────────────────
# KAFKA UI
# ─────────────────────────────────────────────
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=change-this-password

# ─────────────────────────────────────────────
# KUBERNETES (production only)
# ─────────────────────────────────────────────
K8S_NAMESPACE=nexus
K8S_REPLICAS_API=3
K8S_REPLICAS_WORKER=5
K8S_REPLICAS_FRONTEND=2
